<?xml version="1.0" encoding="UTF-8"?>

<?import com.jfoenix.controls.JFXHamburger?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<ScrollPane prefHeight="640.0" prefWidth="360.0" fitToWidth="true"
            xmlns="http://javafx.com/javafx/25"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="edu.westga.cs3212.group5.nutritiontracker.view.HomeDashboardPageController">

   <content>
      <AnchorPane prefWidth="360.0" prefHeight="900.0"
                  style="-fx-background-color: #F3EDE4;">
         <children>

            <!-- Header row -->
            <JFXHamburger fx:id="hamburgerMenu" layoutX="15.0" layoutY="15.0" />

            <Button fx:id="logoutButton" layoutX="275.0" layoutY="10.0"
                    prefHeight="24.0" prefWidth="70.0"
                    style="-fx-background-color: #b8d5a3;" text="Logout"/>

            <!-- Welcome labels -->
            <Label fx:id="welcomeLabel" layoutX="40.0" layoutY="58.0"
                   style="-fx-font-family: 'Bookman Old Style'; -fx-font-size: 18px; -fx-font-weight: bold;"
                   text="Welcome," textFill="#1f5c33"/>

            <Label fx:id="nameLabel" layoutX="148.0" layoutY="58.0"
                   style="-fx-font-family: 'Bookman Old Style'; -fx-font-size: 18px; -fx-font-weight: bold;"
                   text="{name}" textFill="#1f5c33"/>

            <!-- Date picker -->
            <DatePicker fx:id="calendarPicker" layoutX="20.0" layoutY="96.0" prefWidth="148.0"/>

            <!-- MENU PANE (overlay) -->
            <Pane fx:id="menuPane" prefHeight="900.0" prefWidth="207.0"
                  style="-fx-background-color: #87b442;" visible="false">
               <children>
                  <Button fx:id="homeButton" layoutY="60.0" prefHeight="45.0" prefWidth="208.0"
                          style="-fx-background-color: #DECFBD;" text="Home"/>
                  <Button fx:id="createFoodButton" layoutY="115.0" prefHeight="45.0" prefWidth="208.0"
                          style="-fx-background-color: #DECFBD;" text="Create Food"/>
                  <Button fx:id="addFoodButton" layoutY="170.0" prefHeight="45.0" prefWidth="208.0"
                          style="-fx-background-color: #DECFBD;" text="Add Food"/>
               </children>
            </Pane>

            <!-- MAIN MEALS CARD -->
            <Pane layoutX="18.0" layoutY="148.0"
                  prefHeight="720.0" prefWidth="324.0"
                  style="-fx-background-color: #DECFBD;
                         -fx-background-radius: 18;
                         -fx-border-radius: 18;
                         -fx-border-color: rgba(31,92,51,0.25);
                         -fx-border-width: 2;">
               <children>

                  <VBox layoutX="10.0" layoutY="10.0"
                        prefWidth="304.0"
                        spacing="14.0">
                     <padding>
                        <Insets top="10" bottom="14" left="10" right="10"/>
                     </padding>

                     <!-- Card header: Today + date -->
                     <HBox alignment="CENTER_LEFT">
                        <Label text="Today"
                               style="-fx-font-size: 19px; -fx-font-weight: bold;"
                               textFill="#1f5c33"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Label fx:id="todayDateLabel"
                               style="-fx-font-size: 13px; -fx-font-weight: bold;"
                               textFill="#1f5c33"/>
                     </HBox>

                     <Pane prefHeight="1" style="-fx-background-color: rgba(31,92,51,0.3);" />

                     <!-- Breakfast -->
                     <VBox spacing="6"
                           style="-fx-background-color: #F3EDE4; -fx-background-radius: 12;">
                        <padding><Insets top="8" left="10" right="8" bottom="10"/></padding>
                        <HBox>
                           <Label text="Breakfast"
                                  style="-fx-font-size: 14px; -fx-font-weight: bold;"
                                  textFill="#1f5c33"/>
                           <Region HBox.hgrow="ALWAYS"/>
                           <Button fx:id="addBreakfastButton" text="+"
                                   prefWidth="28" prefHeight="26"
                                   style="-fx-background-color: #87b442; -fx-text-fill: white;"/>
                        </HBox>
                        <ListView fx:id="breakfastListView" prefHeight="100" prefWidth="270"/>
                     </VBox>

                     <!-- Lunch -->
                     <VBox spacing="6"
                           style="-fx-background-color: #F3EDE4; -fx-background-radius: 12;">
                        <padding><Insets top="8" left="10" right="8" bottom="10"/></padding>
                        <HBox>
                           <Label text="Lunch"
                                  style="-fx-font-size: 14px; -fx-font-weight: bold;"
                                  textFill="#1f5c33"/>
                           <Region HBox.hgrow="ALWAYS"/>
                           <Button fx:id="addLunchButton" text="+"
                                   prefWidth="28" prefHeight="26"
                                   style="-fx-background-color: #87b442; -fx-text-fill: white;"/>
                        </HBox>
                        <ListView fx:id="lunchListView" prefHeight="100" prefWidth="270"/>
                     </VBox>

                     <!-- Dinner -->
                     <VBox spacing="6"
                           style="-fx-background-color: #F3EDE4; -fx-background-radius: 12;">
                        <padding><Insets top="8" left="10" right="8" bottom="10"/></padding>
                        <HBox>
                           <Label text="Dinner"
                                  style="-fx-font-size: 14px; -fx-font-weight: bold;"
                                  textFill="#1f5c33"/>
                           <Region HBox.hgrow="ALWAYS"/>
                           <Button fx:id="addDinnerButton" text="+"
                                   prefWidth="28" prefHeight="26"
                                   style="-fx-background-color: #87b442; -fx-text-fill: white;"/>
                        </HBox>
                        <ListView fx:id="dinnerListView" prefHeight="100" prefWidth="270"/>
                     </VBox>

                     <!-- Snacks -->
                     <VBox spacing="6"
                           style="-fx-background-color: #F3EDE4; -fx-background-radius: 12;">
                        <padding><Insets top="8" left="10" right="8" bottom="10"/></padding>
                        <HBox>
                           <Label text="Snacks"
                                  style="-fx-font-size: 14px; -fx-font-weight: bold;"
                                  textFill="#1f5c33"/>
                           <Region HBox.hgrow="ALWAYS"/>
                           <Button fx:id="addSnacksButton" text="+"
                                   prefWidth="28" prefHeight="26"
                                   style="-fx-background-color: #87b442; -fx-text-fill: white;"/>
                        </HBox>
                        <ListView fx:id="snacksListView" prefHeight="100" prefWidth="270"/>
                     </VBox>

                     <!-- Total calories footer -->
                     <HBox alignment="CENTER" spacing="8"
                           style="-fx-background-color: #b8d5a3; -fx-background-radius: 12;">
                        <padding><Insets top="10" bottom="10"/></padding>
                        <Label text="Total Calories:"
                               style="-fx-font-size: 15px; -fx-font-weight: bold;"
                               textFill="#1f5c33"/>
                        <Label fx:id="totalCaloriesLabel" text="0 kcal"
                               style="-fx-font-size: 17px; -fx-font-weight: bold;"
                               textFill="#1f5c33"/>
                     </HBox>

                  </VBox>
               </children>
            </Pane>

         </children>
      </AnchorPane>
   </content>
</ScrollPane>
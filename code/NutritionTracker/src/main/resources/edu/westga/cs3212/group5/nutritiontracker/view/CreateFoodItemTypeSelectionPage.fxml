<?xml version="1.0" encoding="UTF-8"?>

<?import com.jfoenix.controls.JFXHamburger?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.control.MenuButton?>
<?import javafx.scene.control.MenuItem?>

<AnchorPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="640.0" prefWidth="360.0" style="-fx-background-color: #F3EDE4;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="edu.westga.cs3212.group5.nutritiontracker.view.CreateFoodItemTypeSelectionPageController">
   <children>

      <!-- Title -->
      <Label alignment="CENTER" layoutX="18.0" layoutY="60.0" prefHeight="130.0" prefWidth="323.0" text="Select How You Want To Create Your Food." textAlignment="CENTER" textFill="#1f5c33" wrapText="true">
         <font><Font name="Bookman Old Style Bold" size="32.0" /></font>
      </Label>

      <!-- Direct nutritional values button -->
      <Button fx:id="selectBaseFoodButton" layoutX="40.0" layoutY="260.0" mnemonicParsing="false" prefHeight="96.0" prefWidth="280.0" style="-fx-background-color: #b8d5a3;" text="Enter Nutritional Values Directly" textAlignment="CENTER" wrapText="true">
         <font><Font name="System Bold" size="20.0" /></font>
      </Button>

      <!-- Build from existing foods button -->
      <Button fx:id="selectCompositFoodButton" layoutX="40.0" layoutY="430.0" mnemonicParsing="false" prefHeight="96.0" prefWidth="280.0" style="-fx-background-color: #b8d5a3;" text="Build From Existing Foods" textAlignment="CENTER" wrapText="true">
         <font><Font name="System Bold" size="20.0" /></font>
      </Button>

		<!-- Account Settings Menu -->
		<MenuButton fx:id="accountMenu" layoutX="292.0"
			layoutY="11.0" mnemonicParsing="false" prefHeight="27.0"
			prefWidth="56.0" style="-fx-background-color: #b8d5a3;" text="👤">
			<items>
				<MenuItem mnemonicParsing="false"
					onAction="#handleEditDietPlan" text="Edit Diet Plan" />
				<MenuItem mnemonicParsing="false" onAction="#handleLogout"
					text="Logout" />
			</items>
			<font>
				<Font name="System Bold" size="13.0" />
			</font>
		</MenuButton>

      <!-- Menu pane -->
      <Pane fx:id="menuPane" prefHeight="640.0" prefWidth="207.0" style="-fx-background-color: #87b442;" visible="false">
         <children>
            <Button fx:id="homeButton" layoutY="55.0" mnemonicParsing="false" prefHeight="45.0" prefWidth="208.0" style="-fx-background-color: #DECFBD;" text="Home" textFill="#1f5c33">
               <font><Font name="Bookman Old Style Bold" size="22.0" /></font>
            </Button>
            <Button fx:id="createMealButton" disable="true" layoutY="112.0" mnemonicParsing="false" prefHeight="45.0" prefWidth="208.0" style="-fx-background-color: #DECFBD;" text="Create Meal" textFill="#1f5c33" visible="false">
               <font><Font name="Bookman Old Style Bold" size="22.0" /></font>
            </Button>
         </children>
      </Pane>

      <JFXHamburger fx:id="hamburgerMenu" layoutX="15.0" layoutY="15.0" prefHeight="20.0" prefWidth="33.0" />

   </children>
</AnchorPane>

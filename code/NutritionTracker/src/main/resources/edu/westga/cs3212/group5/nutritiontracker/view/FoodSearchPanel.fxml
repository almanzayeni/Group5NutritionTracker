<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox fx:id="foodSearchPanel" spacing="8"
      style="-fx-background-color: transparent;"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="edu.westga.cs3212.group5.nutritiontracker.view.FoodSearchPanelController">

    <HBox spacing="8" prefWidth="310.0">
        <TextField fx:id="searchTextField"
                   promptText="Search foods... (e.g. chicken, apple)"
                   prefHeight="30.0"
                   HBox.hgrow="ALWAYS" />
    </HBox>
    <HBox spacing="8" prefWidth="310.0">
        <Label text="Sort:" textFill="#6e2316" style="-fx-font-weight: bold;" />
        <ComboBox fx:id="sortComboBox" prefWidth="220.0" prefHeight="28.0" />
    </HBox>

    <ListView fx:id="resultsListView" prefHeight="220.0" prefWidth="310.0" />

    <Label fx:id="statusLabel" text=" " textFill="#6e2316" wrapText="true"
           prefWidth="310.0" style="-fx-font-style: italic;">
        <font><Font size="12.0" /></font>
    </Label>

    <!-- Shown only when used as a standalone page (managed=false hides and removes from layout) -->
    <Label fx:id="selectionLabel"
           text="No food selected." textFill="#1f5c33"
           prefWidth="310.0" managed="false" visible="false"
           style="-fx-font-style: italic;">
        <font><Font size="13.0" /></font>
    </Label>

    <Button fx:id="addSelectedFoodButton"
            text="Add Selected Food →"
            prefHeight="45.0" prefWidth="310.0"
            managed="false" visible="false"
            mnemonicParsing="false"
            style="-fx-background-color: #3a7d44; -fx-text-fill: white;">
        <font><Font name="System Bold" size="18.0" /></font>
    </Button>

</VBox>

<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox fx:id="foodSearchPanel" spacing="10"
      prefWidth="318.0"
      style="-fx-background-color: transparent;"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="edu.westga.cs3212.group5.nutritiontracker.view.FoodSearchPanelController">

    <!-- Search field -->
    <HBox spacing="8" prefWidth="318.0">
        <TextField fx:id="searchTextField"
                   promptText="Search foods... (e.g. chicken, apple)"
                   prefHeight="34.0"
                   HBox.hgrow="ALWAYS" />
    </HBox>

    <!-- Sort row -->
    <HBox spacing="8" prefWidth="318.0" style="-fx-alignment: CENTER_LEFT;">
        <Label text="Sort:" textFill="#6e2316" style="-fx-font-weight: bold; -fx-font-size: 13;" />
        <ComboBox fx:id="sortComboBox" prefWidth="240.0" prefHeight="30.0" />
    </HBox>

    <!-- Results list - taller for readability -->
    <ListView fx:id="resultsListView" prefHeight="230.0" prefWidth="318.0" />

    <!-- Status label -->
    <Label fx:id="statusLabel" text=" " textFill="#6e2316" wrapText="true"
           prefWidth="318.0" style="-fx-font-style: italic; -fx-font-size: 12;">
    </Label>

    <!-- Portion size row (ingredient mode only) -->
    <HBox fx:id="portionSizeRow" spacing="10" prefWidth="318.0"
          managed="false" visible="false" style="-fx-alignment: CENTER_LEFT;">
        <Label text="Portion amount:" textFill="#6e2316"
               style="-fx-font-weight: bold; -fx-font-size: 13;" />
        <Spinner fx:id="portionSizeSpinner" prefWidth="88.0" prefHeight="30.0" />
        <Label fx:id="portionUnitLabel" text="" textFill="#6e2316"
               style="-fx-font-style: italic; -fx-font-size: 13;" />
    </HBox>

    <!-- Standalone mode controls -->
    <Label fx:id="selectionLabel"
           text="No food selected." textFill="#1f5c33"
           prefWidth="318.0" managed="false" visible="false"
           style="-fx-font-style: italic; -fx-font-size: 13;">
    </Label>

    <Button fx:id="addSelectedFoodButton"
            text="Add Selected Food →"
            prefHeight="44.0" prefWidth="318.0"
            managed="false" visible="false"
            mnemonicParsing="false"
            style="-fx-background-color: #3a7d44; -fx-text-fill: white;">
        <font><Font name="System Bold" size="16.0" /></font>
    </Button>

</VBox>
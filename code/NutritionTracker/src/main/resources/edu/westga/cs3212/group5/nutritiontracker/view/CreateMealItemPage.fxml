<?xml version="1.0" encoding="UTF-8"?>

<?import com.jfoenix.controls.JFXHamburger?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.control.MenuButton?>
<?import javafx.scene.control.MenuItem?>

<ScrollPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="640.0" prefWidth="375.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="edu.westga.cs3212.group5.nutritiontracker.view.CreateMealItemPageController">
   <content>
      <AnchorPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="1075.0" prefWidth="360.0" style="-fx-background-color: #F3EDE4;">
         <children>

            <!-- Title -->
            <Label layoutX="41.0" layoutY="51.0" text="Add New Meal" textAlignment="CENTER" textFill="#1f5c33">
               <font><Font name="Bookman Old Style Bold" size="36.0" /></font>
            </Label>
            <!-- Name -->
            <Label alignment="CENTER_RIGHT" layoutX="-6.0" layoutY="106.0" prefHeight="27.0" prefWidth="135.0" text="Name:" textFill="#6e2316">
               <font><Font name="System Bold" size="16.0" /></font>
            </Label>
            <TextField fx:id="descriptionTextField" layoutX="142.0" layoutY="106.0" prefHeight="26.0" prefWidth="166.0" />

            <!-- ─── SEARCH SECTION ─── -->
            <Label layoutX="21.0" layoutY="143.0" text="Search &amp; Add Food Items:" textFill="#1f5c33">
               <font><Font name="System Bold" size="15.0" /></font>
            </Label>

            <!-- Embedded reusable search panel -->
            <VBox layoutX="21.0" layoutY="167.0">
               <fx:include fx:id="searchPanel" source="FoodSearchPanel.fxml" />
            </VBox>

            <!-- Selection feedback label -->
            <Label fx:id="searchSelectionLabel" layoutX="21.0" layoutY="480.0" prefWidth="310.0" style="-fx-font-style: italic;" text="No food selected from search." textFill="#555555">
               <font><Font size="12.0" /></font>
            </Label>

            <!-- SEPARATE Add Ingredient button — only adds, does not search -->
            <Button fx:id="addFoodButton" layoutX="21.0" layoutY="514.0" mnemonicParsing="false" prefHeight="38.0" prefWidth="310.0" style="-fx-background-color: #3a7d44; -fx-text-fill: white;" text="+ Add Selected Food">
               <font><Font name="System Bold" size="14.0" /></font>
            </Button>

            <!-- ─── INGREDIENT LIST SECTION ─── -->
            <Label layoutX="96.0" layoutY="555.0" prefHeight="26.0" prefWidth="160.0" text="Selected Ingredients" textFill="#6e2316">
               <font><Font name="System Bold" size="16.0" /></font>
            </Label>
            <ListView fx:id="selectedIngredientsListView" layoutX="21.0" layoutY="585.0" prefHeight="180.0" prefWidth="310.0" />

            <Label fx:id="ingredientStatusLabel" layoutX="25.0" layoutY="825.0" prefHeight="18.0" prefWidth="310.0" style="-fx-font-style: italic;" text="" textFill="#1f5c33">
               <font><Font size="12.0" /></font>
            </Label>

            <!-- ─── NUTRITIONAL TOTALS ─── -->
            <Label alignment="CENTER_RIGHT" layoutX="-4.0" layoutY="795.0" prefHeight="27.0" prefWidth="135.0" text="Calories:" textFill="#6e2316">
               <font><Font name="System Bold" size="16.0" /></font>
            </Label>
            <TextField fx:id="caloriesTextField" editable="false" layoutX="143.0" layoutY="795.0" prefHeight="26.0" prefWidth="166.0" />
            <Label alignment="BOTTOM_LEFT" layoutX="314.0" layoutY="795.0" prefHeight="26.0" prefWidth="50.0" text="cals" textFill="#6e2316" />

            <Label alignment="CENTER_RIGHT" layoutX="-4.0" layoutY="830.0" prefHeight="27.0" prefWidth="135.0" text="Protein:" textFill="#6e2316">
               <font><Font name="System Bold" size="16.0" /></font>
            </Label>
            <TextField fx:id="proteinTextField" editable="false" layoutX="144.0" layoutY="830.0" prefHeight="26.0" prefWidth="166.0" />
            <Label alignment="BOTTOM_LEFT" layoutX="314.0" layoutY="830.0" prefHeight="26.0" prefWidth="50.0" text="g" textFill="#6e2316" />

            <Label alignment="CENTER_RIGHT" layoutX="-3.0" layoutY="865.0" prefHeight="27.0" prefWidth="135.0" text="Fat:" textFill="#6e2316">
               <font><Font name="System Bold" size="16.0" /></font>
            </Label>
            <TextField fx:id="fatTextField" editable="false" layoutX="144.0" layoutY="865.0" prefHeight="26.0" prefWidth="166.0" />
            <Label alignment="BOTTOM_LEFT" layoutX="314.0" layoutY="865.0" prefHeight="26.0" prefWidth="50.0" text="g" textFill="#6e2316" />

            <Label alignment="CENTER_RIGHT" layoutX="-4.0" layoutY="900.0" prefHeight="27.0" prefWidth="135.0" text="Sugar:" textFill="#6e2316">
               <font><Font name="System Bold" size="16.0" /></font>
            </Label>
            <TextField fx:id="sugarTextField" editable="false" layoutX="143.0" layoutY="900.0" prefHeight="26.0" prefWidth="166.0" />
            <Label alignment="BOTTOM_LEFT" layoutX="314.0" layoutY="900.0" prefHeight="26.0" prefWidth="50.0" text="g" textFill="#6e2316" />

            <Label alignment="CENTER_RIGHT" layoutX="-3.0" layoutY="935.0" prefHeight="27.0" prefWidth="135.0" text="Carbohydrates:" textFill="#6e2316">
               <font><Font name="System Bold" size="16.0" /></font>
            </Label>
            <TextField fx:id="carbohydratesTextField" editable="false" layoutX="144.0" layoutY="935.0" prefHeight="26.0" prefWidth="166.0" />
            <Label alignment="BOTTOM_LEFT" layoutX="314.0" layoutY="935.0" prefHeight="26.0" prefWidth="50.0" text="g" textFill="#6e2316" />

            <Label alignment="CENTER_RIGHT" layoutX="-3.0" layoutY="970.0" prefHeight="18.0" prefWidth="135.0" text="Sodium:" textFill="#6e2316">
               <font><Font name="System Bold" size="16.0" /></font>
            </Label>
            <TextField fx:id="sodiumTextField" editable="false" layoutX="144.0" layoutY="970.0" prefHeight="26.0" prefWidth="166.0" />
            <Label alignment="BOTTOM_LEFT" layoutX="314.0" layoutY="970.0" prefHeight="26.0" prefWidth="50.0" text="mg" textFill="#6e2316" />

            <!-- Save Food button -->
            <Button fx:id="addMealButton" layoutX="125.0" layoutY="1007.0" mnemonicParsing="false" prefHeight="40.0" prefWidth="110.0" style="-fx-background-color: #b8d5a3;" text="Add Meal">
               <font><Font name="System Bold" size="18.0" /></font>
            </Button>

			<!-- Account Settings Menu -->
			<MenuButton fx:id="accountMenu" layoutX="292.0"
				layoutY="11.0" mnemonicParsing="false" prefHeight="27.0"
				prefWidth="56.0" style="-fx-background-color: #b8d5a3;" text="👤">
				<items>
					<MenuItem mnemonicParsing="false"
						onAction="#handleEditDietPlan" text="Edit Diet Plan" />
					<MenuItem mnemonicParsing="false" onAction="#handleLogout"
						text="Logout" />
				</items>
				<font>
					<Font name="System Bold" size="13.0" />
				</font>
			</MenuButton>

            <!-- Side menu pane -->
            <Pane fx:id="menuPane" prefHeight="640.0" prefWidth="207.0" style="-fx-background-color: #87b442;" visible="false" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.topAnchor="0.0">
               <children>
                  <Button fx:id="homeButton" layoutY="55.0" mnemonicParsing="false" prefHeight="45.0" prefWidth="208.0" style="-fx-background-color: #DECFBD;" text="Home" textFill="#1f5c33">
                     <font><Font name="Bookman Old Style Bold" size="24.0" /></font>
                  </Button>
                  <Button fx:id="createFoodButton" layoutY="112.0" mnemonicParsing="false" prefHeight="45.0" prefWidth="208.0" style="-fx-background-color: #DECFBD;" text="Create Food" textFill="#1f5c33">
                     <font>
                        <Font name="Bookman Old Style Bold" size="24.0" />
                     </font>
                  </Button>
               </children>
            </Pane>

            <JFXHamburger fx:id="hamburgerMenu" layoutX="15.0" layoutY="15.0" prefHeight="20.0" prefWidth="33.0" />

         </children>
      </AnchorPane>
   </content>
</ScrollPane>

<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="640.0" prefWidth="360.0" style="-fx-background-color: #F3EDE4;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="edu.westga.cs3212.group5.nutritiontracker.view.LoginPageController">

   <children>

      <!-- App Title -->
      <Label alignment="CENTER" layoutX="44.0" layoutY="98.0" prefHeight="37.0" prefWidth="272.0" text="NutritionTracker" textFill="#1f5c33">
         <font>
            <Font name="Bookman Old Style Bold" size="30.0" />
         </font>
      </Label>

      <!-- Username Label -->
      <Label layoutX="40.0" layoutY="207.0" text="Username" textFill="#1f5c33">
         <font>
            <Font name="Bookman Old Style Bold" size="14.0" />
         </font>
      </Label>

      <!-- Username Field -->
      <TextField fx:id="usernameField" layoutX="40.0" layoutY="229.0" prefHeight="38.0" prefWidth="280.0" promptText="Enter your username" style="-fx-background-color: #DECFBD; -fx-background-radius: 8;                         -fx-border-color: rgba(31,92,51,0.35); -fx-border-radius: 8;                         -fx-border-width: 1.5; -fx-font-size: 13px;" />

      <!-- Password Label -->
      <Label layoutX="40.0" layoutY="287.0" text="Password" textFill="#1f5c33">
         <font>
            <Font name="Bookman Old Style Bold" size="14.0" />
         </font>
      </Label>

      <!-- PasswordField -->
      <PasswordField fx:id="passwordField" layoutX="40.0" layoutY="309.0" prefHeight="38.0" prefWidth="280.0" promptText="Enter your password" style="-fx-background-color: #DECFBD; -fx-background-radius: 8;                             -fx-border-color: rgba(31,92,51,0.35); -fx-border-radius: 8;                             -fx-border-width: 1.5; -fx-font-size: 13px;" />

      <!-- Error Label -->
      <Label fx:id="errorLabel" layoutX="40.0" layoutY="362.0" prefWidth="280.0" text="" textFill="#c0392b" wrapText="true">
         <font>
            <Font size="12.0" />
         </font>
      </Label>

      <!-- Login Button -->
      <Button fx:id="loginButton" layoutX="40.0" layoutY="391.0" mnemonicParsing="false" onAction="#handleLogin" prefHeight="44.0" prefWidth="280.0" style="-fx-background-color: #87b442; -fx-text-fill: white;                      -fx-background-radius: 10;" text="Login">
         <font>
            <Font name="System Bold" size="15.0" />
         </font>
      </Button>

      <!-- Don't have an account label -->
      <Label layoutX="59.0" layoutY="460.0" text="Don't have an account?">
         <font>
            <Font size="13.0" />
         </font>
      </Label>

      <!-- Sign Up underlined button -->
      <Button fx:id="createAccountButton" layoutX="195.0" layoutY="460.0" mnemonicParsing="false" onAction="#handleCreateAccount" prefHeight="19.0" prefWidth="95.0" style="-fx-background-color: transparent; -fx-text-fill: #1f5c33;                      -fx-underline: true; -fx-font-size: 13px;                      -fx-cursor: hand; -fx-padding: 0;" text="Create Account" textFill="#35a82a">
         <font>
            <Font name="System Bold" size="12.0" />
         </font></Button>

   </children>
</AnchorPane>

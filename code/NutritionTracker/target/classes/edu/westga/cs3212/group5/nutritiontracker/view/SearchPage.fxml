<?xml version="1.0" encoding="UTF-8"?>

<?import com.jfoenix.controls.JFXHamburger?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<?xml-model href="SearchPage.fxml"?>
<AnchorPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="640.0" prefWidth="360.0" style="-fx-background-color: #F3EDE4;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="edu.westga.cs3212.group5.nutritiontracker.view.SearchPageController">
   <children>

      <!-- Title -->
      <Label layoutX="68.0" layoutY="35.0" text="Search Foods" textAlignment="CENTER" textFill="#1f5c33">
         <font><Font name="Bookman Old Style Bold" size="32.0" /></font>
      </Label>

      <!-- Logout button -->
      <Button fx:id="logoutButton" layoutX="275.0" layoutY="10.0" mnemonicParsing="false" prefHeight="20.0" prefWidth="70.0" style="-fx-background-color: #b8d5a3;" text="Logout">
         <font><Font name="System Bold" size="14.0" /></font>
      </Button>

      <!-- Search panel (Add button + selection label enabled via enableStandaloneMode()) -->
      <VBox layoutX="25.0" layoutY="75.0" spacing="0">
         <fx:include fx:id="searchPanel" source="FoodSearchPanel.fxml" />
      </VBox>

      <!-- Hamburger menu -->
      <JFXHamburger fx:id="hamburgerMenu" layoutX="15.0" layoutY="15.0" prefHeight="20.0" prefWidth="33.0" />

      <!-- Side menu pane -->
      <Pane fx:id="menuPane" prefHeight="640.0" prefWidth="207.0" style="-fx-background-color: #87b442;" visible="false" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.topAnchor="0.0">
         <children>
            <Button fx:id="homeButton" layoutY="55.0" mnemonicParsing="false" prefHeight="45.0" prefWidth="208.0" style="-fx-background-color: #DECFBD;" text="Home" textFill="#1f5c33">
               <font><Font name="Bookman Old Style Bold" size="24.0" /></font>
            </Button>
         </children>
      </Pane>

   </children>
</AnchorPane>
